# Example environment file for Document Manager
# Copy this to `.env` and replace placeholder values with your own secrets.
# Do NOT commit a real `.env` with secrets to version control.

# Server
PORT=3000

# Rate limiter settings
# Maximum requests per window
REQUEST_LIMIT=50
# Window size in milliseconds (e.g. 60000 = 1 minute)
WINDOW_MS=60000
# Cooldown in milliseconds for blocked clients (e.g. 30000 = 30s)
COOLDOWN_MS=30000

# JWT secret used to sign tokens (replace with a strong secret)
JWT_SECRET=your_jwt_secret_here

# MongoDB connection string
# For local development you can use: mongodb://localhost:27017/document_manager
# For Atlas use a connection string like:
# mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/document_manager

# Directory where uploaded files are stored (relative to project root)
UPLOAD_DIR=./uploads

# Base API URL (used by some services)
API_URL=http://localhost:3000
